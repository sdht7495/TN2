  {
    "id": "f404000000000007",
    "type": "function",
    "z": "f404000000000001",
    "name": "Tách số đo và trạng thái",
    "func": "const data = msg.payload;\nif (!data || typeof data !== 'object' || Array.isArray(data)) {\n    node.warn('Expected a telemetry JSON object');\n    return null;\n}\n\nconst temperature = Number.isFinite(data.temp) ? { payload: data.temp, topic: 'Nhiệt độ' } : null;\nconst humidity = Number.isFinite(data.hum) ? { payload: data.hum } : null;\nconst uptime = Number.isFinite(data.uptime) ? `${data.uptime} s` : '—';\nconst rssi = Number.isFinite(data.rssi) ? `${data.rssi} dBm` : '—';\nconst source = data.source === 'demo' ? 'Demo' : data.source === 'sht31' ? 'SHT31' : 'Không rõ';\nconst sensor = temperature && humidity ? source : `${source} · thiếu số đo`;\nconst button = data.button === true ? 'ĐANG NHẤN' : data.button === false ? 'ĐÃ NHẢ' : '—';\nconst presses = Number.isInteger(data.presses) ? ` · ${data.presses} lần` : '';\nconst led = data.led === true ? 'BẬT' : data.led === false ? 'TẮT' : '—';\n\nreturn [temperature, humidity,\n    { payload: `${sensor} · uptime ${uptime} · RSSI ${rssi}` },\n    { payload: button + presses }, { payload: led }];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
